# ==============================================================================
# .env.example — variáveis da PILHA LOCAL de referência (docker-compose.yml)
#
# Copiar para `.env` na raiz (não versionado — .gitignore já o cobre) e ajustar.
# Sem `.env`, o compose usa placeholders de dev local — suficientes para a
# pilha subir na máquina de desenvolvimento, e NUNCA aceitáveis fora dela.
#
# Regra (ADR-0026 §3): configuração só por ambiente. A mesma imagem que corre
# aqui é a que correrá em produção; só estas variáveis mudam.
#
# As variáveis de runtime do ERP em dev no host (pnpm dev) continuam em
# apps/erp/.env — ver apps/erp/.env.example.
# ==============================================================================

# --- ERP (erp-1 / erp-2, atrás do proxy em http://localhost:8080) -------------
# Gerar com: openssl rand -hex 32. Tem de ser IGUAL nas duas instâncias
# (é o que faz a sessão sobreviver à mudança de instância).
AUTH_SECRET=
# Protege GET /api/metrics.
METRICS_SECRET=
# Credencial do agendador: as rotas /api/cron/* não têm sessão e entram com
# isto. O serviço `cron` do compose usa o mesmo valor (ADR-0032).
CRON_SECRET=

# --- Keycloak (http://localhost:8081, realm `gespro` importado) ---------------
# Desde o ADR-0013 §7 o Keycloak faz parte do PERFIL POR OMISSÃO: o login do
# ERP é OIDC e `docker compose up -d` levanta Postgres E Keycloak.
# BD própria `keycloak` criada pelo one-shot db-init na instância Postgres da pilha.
KEYCLOAK_DB_PASSWORD=
# Administrador inicial (bootstrap) — consola só em localhost.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Segredo do cliente OIDC `gespro-erp` (injectado no import do realm E no ERP).
# Gerar com: openssl rand -hex 32. Sem `|` nem `&` (ver infra/keycloak/import-realm.sh).
KEYCLOAK_CLIENT_SECRET=
# Durações de sessão (ADR-0011/0013 §6) — parâmetros, nunca fixas no realm:
#   AUTH_SESSION_MAX_AGE       intervalo de re-resolução do Auth.js (s; omissão 900 = 15 min)
#   KEYCLOAK_SSO_IDLE_SECONDS  SSO Session Idle (s; omissão 28800 = 8 h)
#   KEYCLOAK_SSO_MAX_SECONDS   SSO Session Max  (s; omissão 43200 = 12 h)
# O ambiente de E2E põe a primeira em segundos — nenhum teste espera 15 minutos.
AUTH_SESSION_MAX_AGE=
KEYCLOAK_SSO_IDLE_SECONDS=
KEYCLOAK_SSO_MAX_SECONDS=

# --- MinIO (API S3 em http://localhost:9000, consola em :9001) ----------------
MINIO_ROOT_USER=gespro
MINIO_ROOT_PASSWORD=
# Bucket criado (e versionado) no arranque pelo one-shot minio-init.
S3_BUCKET=gespro-uploads
