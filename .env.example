# ==============================================================================
# .env.example — GestPro variáveis de runtime
#
# Copiar para .env e preencher os valores reais (dev local).
# Em produção (AWS), os segredos vêm do Secrets Manager — não usar .env.
#
# Mapeamento env ↔ Secrets Manager (spec 16):
#   DATABASE_URL     → gespro/{env}/DATABASE_URL
#   AUTH_SECRET      → gespro/{env}/AUTH_SECRET
#   SMTP_*           → gespro/{env}/SMTP_CREDENTIALS (JSON: host,port,user,pass,from)
#   OTEL_*           → gespro/{env}/OTEL_CREDENTIALS (JSON: endpoint,headers)
#
# NUNCA commitar .env com valores reais. .env está no .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de dados PostgreSQL
# Dev local (docker compose): postgresql://gespro:gespro@localhost:5432/gespro
# Produção: injectado pelo App Runner via Secrets Manager
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/gespro?schema=public"

# URL directa (sem pooler) — necessária para prisma migrate em PgBouncer/Accelerate
DIRECT_URL="postgresql://user:password@localhost:5432/gespro?schema=public"

# ------------------------------------------------------------------------------
# Autenticação (next-auth / Auth.js)
# Gerar com: openssl rand -hex 32
# Produção: injectado pelo App Runner via Secrets Manager (gespro/{env}/AUTH_SECRET)
# ------------------------------------------------------------------------------
AUTH_SECRET=""

# URL base da aplicação (CSRF e redirects Auth.js)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Ambiente
# ------------------------------------------------------------------------------
NODE_ENV="development"

# Versão da aplicação (usada no /api/health e logs)
APP_VERSION="dev"

# ------------------------------------------------------------------------------
# AWS (necessário apenas em dev local para uploads S3)
# Em produção, o App Runner usa a IAM Instance Role — sem chaves longas.
# NUNCA usar chaves longas em produção.
# ------------------------------------------------------------------------------
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="gespro-uploads-dev"

# ------------------------------------------------------------------------------
# Email transaccional (SMTP)
# Produção: injectado pelo App Runner via Secrets Manager (gespro/{env}/SMTP_CREDENTIALS)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@gespro.mz"

# ------------------------------------------------------------------------------
# Observabilidade / OpenTelemetry (spec 14)
# Produção: injectado pelo App Runner via Secrets Manager (gespro/{env}/OTEL_CREDENTIALS)
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME="gespro"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
