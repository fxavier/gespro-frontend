# Base de dados PostgreSQL
# Para dev local com docker-compose: postgresql://gespro:gespro@localhost:5432/gespro
DATABASE_URL="postgresql://user:password@localhost:5432/gestpro?schema=public"

# URL directa (sem pooler) — necessária para prisma migrate em ambientes com PgBouncer/Accelerate
DIRECT_URL="postgresql://user:password@localhost:5432/gestpro?schema=public"

# Segredo Auth.js — gerar com: openssl rand -hex 32
# Usado para assinar/verificar JWT e encriptar sessões (next-auth/jose).
AUTH_SECRET=""

# URL base da aplicação (necessário para CSRF e redirects Auth.js em produção)
NEXTAUTH_URL="http://localhost:3000"

# Ambiente (development | test | production)
# Em development: rate limiting usa memória LRU (sem DB); logs mais verbosos.
NODE_ENV="development"
