{
  "realm": "gespro",
  "enabled": true,
  "displayName": "GestPro",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "loginTheme": "gespro",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt"
  ],
  "defaultLocale": "pt",
  "ssoSessionIdleTimeout": "${env.GESPRO_SSO_IDLE_SECONDS}",
  "ssoSessionMaxLifespan": "${env.GESPRO_SSO_MAX_SECONDS}",
  "smtpServer": {
    "host": "${env.GESPRO_SMTP_HOST}",
    "port": "${env.GESPRO_SMTP_PORT}",
    "from": "noreply@gespro.mz",
    "fromDisplayName": "GestPro",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "plataforma-admin",
        "description": "Pessoal da GestPro que administra a consola de identidade (ADR-0011 §5). NÃO dá acesso aos dados de nenhum cliente — administra identidades, não facturas. Sem correspondência em Postgres e sem membros neste ficheiro."
      }
    ]
  },
  "clients": [
    {
      "clientId": "gespro-erp",
      "name": "GestPro ERP",
      "description": "Cliente OIDC do ERP (Auth.js). Authorization Code + PKCE S256 obrigatório; o segredo nunca chega ao navegador (ADR-0010 §3). A conta de serviço provisiona utilizadores via Admin API (ADR-0013 §2/§5-bis).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${env.GESPRO_ERP_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:8080/*"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
