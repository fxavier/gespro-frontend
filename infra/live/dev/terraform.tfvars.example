# ==============================================================================
# terraform.tfvars.example — Stack: live/dev
#
# Copiar para terraform.tfvars e preencher os valores reais.
# NUNCA commitar terraform.tfvars (está no .gitignore).
# ==============================================================================

aws_region     = "af-south-1"
aws_account_id = "123456789012"  # Substituir pelo ID da conta AWS
image_tag      = "latest"
app_url        = "https://dev.gespro.example.com"
# replica_region = "eu-west-1"  # Opcional em dev; sem ela não há réplica do bucket
# alert_email    = "operacao@example.com"  # Opcional em dev; sem ela não há alarmes
# otel_exporter_otlp_endpoint = "https://otlp.fornecedor.example:4318"  # Opcional
