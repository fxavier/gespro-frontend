# ==============================================================================
# terraform.tfvars.example — Stack: live/prod
#
# Copiar para terraform.tfvars e preencher os valores reais.
# NUNCA commitar terraform.tfvars (está no .gitignore).
# Apply em prod requer aprovação manual no pipeline CI/CD (spec 15).
# ==============================================================================

aws_region     = "af-south-1"
aws_account_id = "123456789012"  # Substituir pelo ID da conta AWS
image_tag      = "sha-abc1234"   # Sempre usar SHA explícita em prod (nunca "latest")
app_url        = "https://gespro.example.com"

# Continuidade (ADR-0020 §2, #575)
replica_region = "eu-west-1" # Obrigatória, sem omissão; diferente de aws_region
# retencao_documentos_fiscais_anos = 10  # Object Lock (GOVERNANCE); mínimo 10 em prod

# Alertas (#576)
alert_email = "operacao@example.com" # Obrigatória, sem omissão; confirmar a subscrição SNS após o apply
# otel_exporter_otlp_endpoint = "https://otlp.fornecedor.example:4318"  # Opcional; sem ela o SDK OTel fica desligado
