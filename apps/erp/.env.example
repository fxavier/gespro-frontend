# ==============================================================================
# .env.example — GestPro variáveis de runtime
#
# Copiar para .env e preencher os valores reais (dev local).
# Em produção (AWS), os segredos vêm do Secrets Manager — não usar .env.
#
# Mapeamento env ↔ Secrets Manager (spec 16):
#   DATABASE_URL     → gespro/{env}/DATABASE_URL
#   AUTH_SECRET      → gespro/{env}/AUTH_SECRET
#   SMTP_*           → gespro/{env}/SMTP_CREDENTIALS (JSON: host,port,user,pass,from)
#   OTEL_*           → gespro/{env}/OTEL_CREDENTIALS (JSON: endpoint,headers)
#
# NUNCA commitar .env com valores reais. .env está no .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de dados PostgreSQL
# Dev local (docker compose): postgresql://gespro:gespro@localhost:5432/gespro
# Produção: injectado pelo App Runner via Secrets Manager
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/gespro?schema=public"

# URL directa (sem pooler) — necessária para prisma migrate em PgBouncer/Accelerate
DIRECT_URL="postgresql://user:password@localhost:5432/gespro?schema=public"

# ------------------------------------------------------------------------------
# Autenticação (next-auth / Auth.js)
# Gerar com: openssl rand -hex 32
# Produção: injectado pelo App Runner via Secrets Manager (gespro/{env}/AUTH_SECRET)
# ------------------------------------------------------------------------------
AUTH_SECRET=""

# URL base da aplicação (CSRF e redirects Auth.js)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Ambiente
# ------------------------------------------------------------------------------
NODE_ENV="development"

# Versão da aplicação (usada no /api/health e logs)
APP_VERSION="dev"

# ------------------------------------------------------------------------------
# Storage de documentos (WS-DOC-CORE / spec 01)
# STORAGE_DRIVER=local  → grava no filesystem (dev/CI, sem rede). Default.
# STORAGE_DRIVER=s3     → presigned URLs contra um bucket S3 privado (produção).
# ------------------------------------------------------------------------------
STORAGE_DRIVER="local"
# Diretório do driver local (default: .next/cache/uploads). Opcional.
STORAGE_LOCAL_DIR=""
# Só usados com STORAGE_DRIVER=s3:
S3_BUCKET="gespro-uploads-dev"
S3_REGION="af-south-1"

# ------------------------------------------------------------------------------
# AWS (necessário apenas em dev local para uploads S3)
# Em produção, o App Runner usa a IAM Instance Role — sem chaves longas.
# NUNCA usar chaves longas em produção.
# ------------------------------------------------------------------------------
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# Email transaccional (SMTP) — provider seleccionado por EMAIL_PROVIDER (smtp|noop)
# Pilha local: o Mailpit apanha tudo — SMTP_HOST=localhost SMTP_PORT=1025
# (UI em http://localhost:8025; aceita qualquer user/pass)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="noop"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@gespro.mz"

# ------------------------------------------------------------------------------
# Observabilidade / OpenTelemetry (spec 14, ADR-0019)
# Mudar de destino de telemetria é UMA variável, nunca código (ADR-0026 §3).
# Pilha local (docker compose --profile full up -d): http://localhost:4318
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME="gespro"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# ------------------------------------------------------------------------------
# Pilha local de referência (ADR-0026) — serviços do perfil `full`.
# Dentro da pilha, os contentores erp-1/erp-2 recebem os equivalentes internos
# (valkey:6379, keycloak:8080, minio:9000) via docker-compose.yml.
# ------------------------------------------------------------------------------
# Valkey (ADR-0014) — SEM porta publicada no host por decisão (rede interna da
# pilha). Para desenvolver o adaptador no host, publica a porta num
# docker-compose.override.yml local (não versionado).
VALKEY_URL=""
# --- Keycloak (ADR-0010/0012/0013) — realm `gespro`, perfil por omissão -------
# Issuer público: o que o browser vê e o `iss` dos tokens declara.
KEYCLOAK_ISSUER="http://localhost:8081/realms/gespro"
# Backchannel (troca de código, renovação, Admin API). Em dev no host é igual
# ao público; dentro da pilha docker é http://keycloak:8080/realms/gespro.
KEYCLOAK_ISSUER_INTERNO=""
KEYCLOAK_CLIENT_ID="gespro-erp"
# Placeholder de dev alinhado com o docker-compose; OBRIGATÓRIO em produção.
KEYCLOAK_CLIENT_SECRET=""
# Intervalo de re-resolução da sessão (s; omissão 900 = 15 min — ADR-0011).
# O E2E põe-no em segundos (playwright.config.ts → webServer.env).
AUTH_SESSION_MAX_AGE=""
# Tecto do cookie de sessão = SSO Session Max do realm (s; omissão 43200).
KEYCLOAK_SSO_MAX_SECONDS=""

# ------------------------------------------------------------------------------
# Onboarding self-service e faturação por subscrição (spec 19)
# Produção: injectado pelo App Runner via Secrets Manager
#   STRIPE_SECRET_KEY       → gespro/{env}/STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET   → gespro/{env}/STRIPE_WEBHOOK_SECRET
#   KEYCLOAK_CLIENT_SECRET  → gespro/{env}/KEYCLOAK_CLIENT_SECRET
#   CAPTCHA_SECRET_KEY      → gespro/{env}/CAPTCHA_SECRET_KEY
# NUNCA commitar valores reais.
# ------------------------------------------------------------------------------

# URL pública da aplicação (redirect do e-mail de acções do Keycloak e
# success/cancel do Checkout). Cai para NEXTAUTH_URL se não definida.
APP_URL="http://localhost:3000"

# Origens autorizadas para CORS (allowlist, NUNCA wildcard). Inclui a origem do
# site de marketing (spec 18) — obrigatório antes do deploy do spec 19.
ALLOWED_ORIGINS="http://localhost:3001,https://www.gespro.mz"

# --- Stripe (billing da subscrição SaaS) ---
# Chave secreta (sk_test_… em modo de teste). Nunca a publishable key aqui.
STRIPE_SECRET_KEY=""
# Segredo de assinatura do endpoint de webhook (whsec_…), por endpoint.
STRIPE_WEBHOOK_SECRET=""

# Price IDs do Stripe — 3 planos × 2 ciclos. Criados no dashboard Stripe;
# a moeda é USD (ver docs/decisions/ADR-0009-moeda-faturacao-saas.md).
STRIPE_PRICE_BASICO_MENSAL=""
STRIPE_PRICE_BASICO_ANUAL=""
STRIPE_PRICE_PROFISSIONAL_MENSAL=""
STRIPE_PRICE_PROFISSIONAL_ANUAL=""
STRIPE_PRICE_EMPRESARIAL_MENSAL=""
STRIPE_PRICE_EMPRESARIAL_ANUAL=""

# --- Captcha do registo público (anti-abuso do trial sem cartão) ---
# turnstile | hcaptcha | none  (none só em dev — recusado em produção)
CAPTCHA_PROVIDER="none"
CAPTCHA_SECRET_KEY=""
# Chave pública do widget, usada pelo site de marketing (spec 18).
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""

# --- Cron de fallback (expiração local de trials) ---
# Já usado pelo cron de transporte; partilhado por /api/cron/expirar-trials.
CRON_SECRET=""
