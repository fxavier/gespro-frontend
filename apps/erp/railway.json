{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/apps/erp/**",
      "/packages/**",
      "/Dockerfile",
      "/.dockerignore",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "preDeployCommand": ["/app/docker-entrypoint.sh migrar"],
    "preDeployTimeoutSeconds": 900,
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30,
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 2
      }
    }
  }
}
