// Identidade (espelho local do Keycloak — ADR-0010/0013) e RBAC (ADR-0011).
// Sessões são JWT — sem tabela. Palavras-passe, MFA, recuperação, convites e
// detecção de força bruta são do Keycloak; o ERP nunca vê uma palavra-passe.

model User {
  id          String    @id @default(cuid())
  tenantId    String
  /// `sub` do Keycloak — chave de correlação entre os dois sistemas (ADR-0013).
  /// Única e não nula: um utilizador sem identidade no Keycloak não entra.
  keycloakSub String    @unique
  nome        String
  /// Único em TODO o sistema, não por tenant: uma Identidade pertence a
  /// exactamente um Tenant (CONTEXT.md). Quem gere duas empresas precisa de
  /// dois endereços de e-mail — o registo di-lo com essas palavras.
  email       String    @unique
  ativo       Boolean   @default(true)
  /// Escrito UMA vez no primeiro `callbacks.signIn` bem sucedido (ADR-0013
  /// §5-bis). «Por activar» é `primeiroAcessoEm == null` — substitui o
  /// `UserInvite.acceptedAt`: mede «já entrou alguma vez», não «aceitou».
  primeiroAcessoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  roles  UserRole[]
  auditLogs AuditLog[]

  @@index([tenantId, ativo])
  @@index([tenantId, email])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String
  nome      String
  descricao String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, nome])
  @@index([tenantId])
}

// Catálogo global de permissões no formato `modulo:accao`.
model Permission {
  id        String   @id @default(cuid())
  code      String   @unique
  descricao String?

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Trilho de auditoria — append-only.
// `requestId` e `keycloakSub` acrescentados a pedido do w8-auditoria
// (execucao-paralela-w8.md §4, conflito 2): correlação com o trilho de
// autenticação do Keycloak (ADR-0011/0015) e com os logs estruturados.
model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  userId   String?
  /// `requestId` do AsyncLocalStorage de observabilidade — liga o acto ao trace.
  requestId   String?
  /// `sub` do autor no Keycloak no momento do acto — correlação entre trilhos.
  keycloakSub String?
  action   String
  entity   String
  entityId String?
  data     Json?
  ip       String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}
