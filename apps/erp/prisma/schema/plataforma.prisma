// WS G — Plataforma
//
// Modelos NOVOS deste workstream.
// NÃO redefine: Tenant, User, Role, Permission, AuditLog (já em auth.prisma / tenant.prisma).
//
// NOTA PARA O ORQUESTRADOR (reconciliação de migrations):
//   1. Adicionar `configuracaoFiscal ConfiguracaoFiscal?` ao modelo `Tenant` em tenant.prisma.
//   2. Adicionar `@relation(fields: [tenantId], references: [id])` ao campo `tenantId`
//      de `ConfiguracaoFiscal` (após a back-reference acima estar em tenant.prisma).
//   3. Adicionar 'ConfiguracaoFiscal' a TENANT_MODELS em tenant-extension.ts.
//   4. Adicionar 'Notificacao' e 'PreferenciaNotificacao' a TENANT_MODELS em tenant-extension.ts.
//
// Durante a Wave 1 (contratos), tenantId é FK escalar válida sem relação Prisma explícita,
// o que evita tocar em ficheiros partilhados. A query de serviço filtra sempre por
// { where: { tenantId: ctx.tenantId } } explicitamente.

enum RegimeIva {
  NORMAL
  SIMPLIFICADO
  ISENTO
}

enum PlanoAssinatura {
  BASICO
  PROFISSIONAL
  EMPRESARIAL
}

/// Configuração fiscal, de contacto e de subscrição do tenant.
/// Complementa o modelo minimalista Tenant (Wave 0) com os dados ricos do mock
/// (conflito #17 do mapa de entidades). Relação 1:1 com Tenant via tenantId @unique.
model ConfiguracaoFiscal {
  id String @id @default(cuid())

  /// FK escalar para Tenant.id (sem @relation enquanto tenant.prisma não for reconciliado).
  tenantId String @unique

  // --- Subscrição ---
  planoAssinatura PlanoAssinatura @default(BASICO)
  statusAtivo     Boolean         @default(true)

  // --- Contacto e localização da empresa ---
  email        String?
  telefone     String?
  endereco     String?
  cidade       String?
  provincia    String?
  codigoPostal String?
  timezone     String  @default("Africa/Maputo")

  // --- Moeda ---
  /// Código ISO 4217 (ex.: "MZN", "USD"). Usado em todos os documentos do tenant.
  moedaBase String @default("MZN")

  // --- Fiscal ---
  regimeIva         RegimeIva @default(NORMAL)
  /// Taxa de IVA por defeito como FRACÇÃO decimal. Ex.: 0.160000 = 16 %.
  /// Consistente com todos os WS (A/B/C/D usam fracção, nunca percentagem). ADR-0003 §4.
  taxaIvaDefault    Decimal   @default(0.160000) @db.Decimal(9, 6)
  /// URL do logótipo da empresa (para emissão de documentos).
  logoEmpresa       String?
  /// Referência à assinatura digital qualificada para documentos fiscais.
  assinaturaDigital String?

  // --- Calendário contabilístico (ADR-0033 §3 e decisão de produto: configurar o automatismo) ---
  //
  // `aberturaExercicioAutomatica` preserva o comportamento que já existe hoje (cron a 1 de
  // Dezembro). O default é TRUE para que tenants já existentes continuem a receber o exercício
  // novo sem acção manual — mudar o default para FALSE em silêncio deixava-os sem exercício
  // a 1 de Janeiro (o mesmo modo de falha que os comentários das SERIES_INICIAIS descrevem).
  //
  // `diaAberturaExercicio` + `mesAberturaExercicio` substituem a data fixa do crontab (0 2 1 12 *)
  // por valores por tenant. Defaults = 1 e 12, preservando o comportamento de hoje.
  // Dia limitado a 1-28: Fevereiro tem 28 dias no mínimo; um dia 29-31 nunca dispararia nesse
  // mês, criando uma armadilha silenciosa (o exercício fica por criar até ao cron do dia seguinte
  // ou à intervenção manual).
  //
  // `fechoPeriodoAutomatico` guarda-se mas NÃO se implementa nesta fase. A pré-condição 7 do
  // ADR-0033 §6 — apuramento do IVA feito (ADR-0034, Fase 2) — ainda não existe. Um cron que
  // feche períodos hoje passaria por cima dessa verificação em silêncio, carimbando exactamente
  // o erro que o ADR-0033 existe para impedir. Quando o ADR-0034 for implementado e a
  // pré-condição 7 estiver em `fecharPeriodo`, a flag pode ser activada.
  //
  // `diasAposFimDoMesParaFechoAutomatico` guarda-se para quando o fecho automático for activado.
  /// Quando TRUE (default), o cron cria o exercício seguinte na data configurada pelo tenant.
  aberturaExercicioAutomatica          Boolean @default(true)
  /// Dia do mês em que o cron tenta criar o exercício seguinte (1-28; default 1 = primeiro do mês).
  diaAberturaExercicio                 Int     @default(1)
  /// Mês do ano em que o cron tenta criar o exercício seguinte (1-12; default 12 = Dezembro).
  mesAberturaExercicio                 Int     @default(12)
  /// Guardado para uso futuro — fecho automático de períodos ainda não implementado (ver comentário acima).
  fechoPeriodoAutomatico               Boolean @default(false)
  /// Quantos dias após o fim do mês se tentará o fecho automático, quando activado (0-60; default 10).
  diasAposFimDoMesParaFechoAutomatico  Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Notificações & Email — WS 13
// ---------------------------------------------------------------------------

/// Tipo/tema da notificação. Cobre alertas de transporte, eventos de autenticação
/// e eventos de negócio futuros.
enum TipoNotificacao {
  DOCUMENTO_EXPIRADO
  DOCUMENTO_PROXIMO_EXPIRAR
  MANUTENCAO_PENDENTE
  RESET_PASSWORD
  CONVITE_UTILIZADOR
  ALERTA_SISTEMA
}

/// Canal de entrega da notificação.
enum CanalNotificacao {
  IN_APP
  EMAIL
}

/// Estado do envio por canal assíncrono (email).
/// Padrão "persistir depois enviar": a Notificacao é criada com PENDENTE,
/// o envio ocorre fora da $transaction de negócio, e o estado é actualizado.
enum EstadoEnvio {
  PENDENTE
  ENVIADO
  FALHA
}

/// Centro de notificações: cada registo é uma notificação entregue (ou a entregar)
/// a um utilizador de um tenant. Inclui canal in-app e canal email.
/// tenantId + userId: isolamento multi-tenant obrigatório.
model Notificacao {
  id     String @id @default(cuid())

  /// FK escalar para Tenant.id (sem @relation enquanto tenant.prisma não for reconciliado).
  tenantId String
  /// FK escalar para User.id.
  userId   String

  tipo      TipoNotificacao
  titulo    String
  mensagem  String
  canal     CanalNotificacao @default(IN_APP)

  /// Referência opcional à entidade que originou a notificação (ex.: documentoId).
  entidadeTipo String?
  entidadeId   String?

  /// Indica se o utilizador já leu a notificação (in-app).
  lida     Boolean  @default(false)
  lidaEm   DateTime?

  /// Estado do envio por email (só relevante quando canal = EMAIL).
  estadoEnvio EstadoEnvio  @default(PENDENTE)
  enviadoEm   DateTime?
  erroEnvio   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, lida])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, tipo, entidadeId])
}

/// Preferências de notificação por utilizador e por tipo.
/// Controla quais os canais activos para cada TipoNotificacao.
model PreferenciaNotificacao {
  id       String @id @default(cuid())

  /// FK escalar para Tenant.id.
  tenantId String
  /// FK escalar para User.id.
  userId   String

  tipo   TipoNotificacao
  /// Canais activos para este tipo de notificação.
  canais CanalNotificacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tipo])
  @@index([tenantId, userId])
}

// ---------------------------------------------------------------------------
// Onboarding self-service, provisionamento e faturação por subscrição — Spec 19
//
// Fronteiras públicas (POST /api/publico/registo, POST /api/webhooks/stripe)
// escrevem SEMPRE via `prismaBase` com `tenantId` explícito: não há
// `runWithTenantContext` (o tenant ainda não existe, ou o pedido vem do Stripe).
// ---------------------------------------------------------------------------

/// Ciclo de vida da subscrição SaaS do tenant (espelha o estado no Stripe).
/// Transições válidas em `src/lib/state-machines.ts` (TRANSICOES_ASSINATURA).
enum EstadoAssinatura {
  TRIAL
  ATIVA

  /// Saída de TRIAL/ATIVA: vê e exporta tudo, não escreve nada, e pode pagar
  /// para sair de lá. Trinta dias (ADR-0027 §6, ADR-0032 §1).
  LEITURA

  /// Fim dos trinta dias de LEITURA. Ninguém entra; nada se apaga (ADR-0027 §7).
  FECHADA

  /// @deprecated Não escrever. Substituídos por LEITURA/FECHADA no ADR-0032 §1;
  /// ficam no enum só pelas linhas que já os têm.
  SUSPENSA
  CANCELADA
  EXPIRADO
}

/// Periodicidade de faturação da subscrição.
enum CicloFaturacao {
  MENSAL
  ANUAL
}

/// Subscrição SaaS do tenant à plataforma GestPro.
///
/// NÃO guarda montantes: o Stripe é a fonte de verdade do valor cobrado
/// (ADR-0009). Isto evita dupla contabilidade com o livro-razão do tenant,
/// que continua em MZN/Decimal e não regista a factura da própria GestPro.
model Assinatura {
  id String @id @default(cuid())

  /// FK escalar para Tenant.id — 1:1 (um tenant, uma subscrição corrente).
  /// Sem `@relation`, como `ConfiguracaoFiscal` acima: FKs cross-domínio são
  /// escalares (CLAUDE.md), o que mantém `tenant.prisma` desacoplado dos
  /// domínios. `onDelete: Cascade` seria ainda pior aqui — o Tenant é
  /// soft-deleted (`deletedAt`), logo um cascade de hard-delete nunca
  /// dispararia no fluxo normal e apagaria o histórico de faturação se
  /// alguma vez disparasse. Os serviços filtram por `tenantId` explicitamente.
  tenantId String @unique

  planoAssinatura PlanoAssinatura  @default(BASICO)
  ciclo           CicloFaturacao?
  estado          EstadoAssinatura @default(TRIAL)

  // --- Referências Stripe (nunca segredos; só identificadores) ---
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // --- Trial sem cartão (14 dias) ---
  trialInicio DateTime @default(now())
  trialFim    DateTime

  // --- Leitura (ADR-0027 §6, ADR-0032 §5) ---
  /// Instante em que o acesso fecha, escrito ao entrar em LEITURA (+30 dias).
  /// Data absoluta e não um início a somar: o processo agendado fica com a
  /// mesma forma do trial (`campoFim < now()`), e estender o prazo a um cliente
  /// é um UPDATE numa data. Nulo em qualquer outro estado.
  leituraFim DateTime?

  /// Quando se avisou que o acesso ia fechar (a sete dias). Existe para o
  /// processo agendado ser idempotente sem adivinhar: correr duas vezes no
  /// mesmo dia não manda dois avisos. Limpa-se ao sair da LEITURA.
  avisoPreFechoEm DateTime?

  dataAtivacao       DateTime?
  dataCancelamento   DateTime?
  motivoCancelamento String?

  /// Falhas de cobrança consecutivas (dunning do Stripe). Zera em invoice.paid.
  tentativasFalhadas Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  /// Cron de fallback: estado=TRIAL AND trialFim < now().
  @@index([estado, trialFim])
  /// Mesmo cron, outra ponta: estado=LEITURA AND leituraFim < now().
  @@index([estado, leituraFim])
}

/// Livro de idempotência dos webhooks Stripe.
/// Modelo de plataforma (não é dado de negócio do tenant): `tenantId` é opcional
/// porque o evento pode chegar antes de o tenant estar resolvido.
/// Está em TENANT_MODEL_EXCECOES (tenant-extension.ts) — acedido só via prismaBase.
model EventoWebhookStripe {
  id String @id @default(cuid())

  /// `evt_...` do Stripe. Unicidade = garantia de processamento no máximo uma vez.
  stripeEventId String   @unique
  tipo          String
  processadoEm  DateTime @default(now())
  tenantId      String?

  /// Preenchido quando o processamento falhou (alerta — spec 14).
  erro String?

  @@index([tipo, processadoEm])
}

// `TokenHandoff` e `TokenVerificacaoEmail` foram REMOVIDOS pelo ADR-0013
// (§5 e §4): o handoff site→app morreu com o provider `handoff`, e a
// verificação de e-mail passou a ser acção obrigatória do Keycloak
// (`VERIFY_EMAIL` + `UPDATE_PASSWORD` + execute-actions-email).

/// Registo de `Idempotency-Key` de endpoints públicos (POST /api/publico/registo).
/// A chave é reservada antes do provisionamento (@unique = trava de corrida) e a
/// resposta é gravada em `respostaJson` para reentregas devolverem o mesmo corpo.
/// Modelo de plataforma — `tenantId` só é conhecido depois do commit.
/// Está em TENANT_MODEL_EXCECOES (tenant-extension.ts) — acedido só via prismaBase.
model ChaveIdempotencia {
  id String @id @default(cuid())

  chave    String  @unique
  endpoint String
  /// Hash do corpo do pedido — mesma chave com corpo diferente = 409.
  fingerprint String

  /// EM_CURSO | CONCLUIDA | FALHADA
  estado       String  @default("EM_CURSO")
  respostaJson Json?
  tenantId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpoint, createdAt])
}
