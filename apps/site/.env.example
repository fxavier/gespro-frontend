# ────────────────────────────────────────────────────────────────────────────
# apps/site — variáveis de ambiente do WEBSITE DE MARKETING
#
# O site é público e não fala com a base de dados nem com o Stripe: não há aqui
# nenhum segredo do ERP. Copiar para `apps/site/.env` para desenvolvimento.
# (Nunca colocar env na raiz do monorepo — cada app carrega a sua.)
# ────────────────────────────────────────────────────────────────────────────

# URL público do próprio site (base de canónicos, sitemap.xml e imagens OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# URL da aplicação ERP — destino do botão "Entrar" e do callback de registo.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base da API pública de onboarding (spec 19). Se omitido, usa NEXT_PUBLIC_APP_URL.
# Consome: GET {PLATAFORMA_API_URL}/api/publico/planos
#          POST {PLATAFORMA_API_URL}/api/publico/registo
# PLATAFORMA_API_URL=http://localhost:3000

# ─── Analytics privacy-first (ADR-0008) ─────────────────────────────────────
# Sem NEXT_PUBLIC_PLAUSIBLE_DOMINIO definido, nenhum script de analytics é
# carregado (comportamento por omissão em desenvolvimento e em CI).
# NEXT_PUBLIC_PLAUSIBLE_DOMINIO=gestpro.co.mz
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
# "obrigatorio" mostra o aviso de consentimento e só carrega o script após
# aceitação. Qualquer outro valor (ou ausência) = medição agregada sem cookies.
# NEXT_PUBLIC_ANALYTICS_CONSENTIMENTO=obrigatorio

# ─── Formulário de contacto ─────────────────────────────────────────────────
# noop = escreve no log do servidor (desenvolvimento); smtp = envia por SMTP.
EMAIL_PROVIDER=noop
CONTACTO_EMAIL_DESTINO=ola@gestpro.co.mz
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="GestPro <ola@gestpro.co.mz>"
