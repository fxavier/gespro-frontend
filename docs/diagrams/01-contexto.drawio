s="geometry"/></mxCell><mxCell id="n11" value="Plataforma GestPro  ·  SaaS multi-tenant para empresas moçambicanas" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9ff;strokeColor=#2257d8;fontColor=#0b1c30;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;container=1;pointerEvents=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="640" height="620" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;ERP GestPro&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;app.gestpro.co.mz · Next.js 16 · 7 domínios (inventário, compras, comercial/POS, finanças, pessoas &amp;amp; projectos, operações, plataforma)&lt;br&gt;login próprio em /auth/login · registo em /registo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="n11"><mxGeometry x="40" y="60" width="300" height="130" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Site de marketing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;gestpro.co.mz · Next.js 16 (SSG/ISR)&lt;br&gt;funil, preços do catálogo real, envia para /registo&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n11"><mxGeometry x="40" y="250" width="300" height="100" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Keycloak 26&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;realm «gespro» · auto-alojado (ADR-0012)&lt;br&gt;responde «quem és»: sub, email, email_verified&lt;br&gt;palavra-passe, verificação de e-mail, força bruta&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n11"><mxGeometry x="380" y="250" width="240" height="130" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b style="color:#0b1c30"&gt;Isolamento&lt;/b&gt;&lt;br&gt;tenantId nunca vem do cliente — vem do contexto (AsyncLocalStorage); cross-tenant devolve 404, nunca 403.&lt;br&gt;&lt;br&gt;&lt;b style="color:#0b1c30"&gt;Fronteira de autorização (ADR-0011)&lt;/b&gt;&lt;br&gt;o token diz quem és; a base de dados diz o que podes: 298 permissões · 5 papéis em Postgres.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;" vertex="1" parent="n11"><mxGeometry x="40" y="400" width="300" height="200" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b style="color:#0b1c30"&gt;Conformidade MZ&lt;/b&gt;&lt;br&gt;MZN · NUIT/BI · PGC-NIRF (Dec. 70/2009) · INSS/IRPS · numeração fiscal sequencial sem lacunas · documentos append-only (estorno / nota de crédito)' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;" vertex="1" parent="n11"><mxGeometry x="380" y="400" width="240" height="200" as="geometry"/></mxCell><mxCell id="n17" value='&lt;b&gt;Stripe&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;subscrições em USD (ADR-0009) · webhooks idempotentes&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f3f7;strokeColor=#8b93a7;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="240" height="70" as="geometry"/></mxCell><mxCell id="n18" value='&lt;b&gt;Fornecedor SMTP&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;e-mail transaccional · persistir-depois-enviar&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f3f7;strokeColor=#8b93a7;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="240" height="70" as="geometry"/></mxCell><mxCell id="n19" value='&lt;b&gt;Armazenamento de objectos (API S3)&lt;/b&gt;&lt;br&gt;&lt;span style="fon