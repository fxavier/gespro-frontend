<mxfile host="drawio" version="26.0.0"><diagram name="CI-CD" id="p1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value='&lt;span style="font-size:22px"&gt;&lt;b&gt;11 · Pipeline de verificação e publicação (CI/CD)&lt;/b&gt;&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0b1c30;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Do portátil à imagem: gates locais, GitHub Actions, imagem OCI e publicação em duas fases (ADR-0022) — destino por decidir (ADR-0026). GestPro ERP · Setembro 2026 · fonte: código em apps/, docs/decisions (ADR-0001…0031)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1500" height="22" as="geometry"/></mxCell><mxCell id="n4" value="1 · Local — antes de entregar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9ff;strokeColor=#c9cfdd;fontColor=#0b1c30;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;container=1;pointerEvents=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="340" height="420" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;pnpm check&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;prisma validate · tsc --noEmit · eslint · vitest (≈1 200 testes)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="20" y="35" width="300" height="60" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;pnpm gates&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;gate-dialog · gate-use-client · gate-data-imports (+ fronteira entre domínios, ADR-0024)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="20" y="110" width="300" height="60" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;pnpm e2e · e2e:a11y&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;Playwright 14 specs contra Keycloak real · axe WCAG AA em 2 temas&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="20" y="185" width="300" height="60" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;pnpm build&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;apanha useSearchParams sem Suspense, RSC runtime&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="20" y="260" width="300" height="60" as="geometry"/></mxCell><mxCell id="n9" value="smoke autenticado obrigatório para UI: o check não apanha runtime RSC nem formulários que não submetem" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="20" y="330" width="300" height="70" as="geometry"/></mxCell><mxCell id="n10" value="2 · GitHub Actions — .github/workflows/ci.yml (push · pull_request)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9ff;strokeColor=#c9cfdd;fontColor=#0b1c30;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;container=1;pointerEvents=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="560" height="420" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;lint-type&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;eslint + tsc&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="20" y="35" width="250" height="60" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;gates&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;scripts/gate-*.mjs&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="285" y="35" width="250" height="60" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;test&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;vitest + cobertura real&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="20" y="105" width="250" height="60" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;integration&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;Testcontainers · Postgres efémero&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="285" y="105" width="250" height="60" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b&gt;e2e&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;Playwright vs build de produção + Keycloak&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="20" y="175" width="250" height="60" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b&gt;a11y&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;axe&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="285" y="175" width="250" height="60" as="geometry"/></mxCell><mxCell id="n17" value='&lt;b&gt;site&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;lint · typecheck · 49 testes · a11y 32/32&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="20" y="245" width="250" height="60" as="geometry"/></mxCell><mxCell id="n18" value='&lt;b&gt;build&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;imagem gespro-erp · lockfile fixo · NODE_ENV correcto&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b1c30;strokeColor=#0b1c30;fontColor=#ffffff;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="20" y="330" width="515" height="60" as="geometry"/></mxCell><mxCell id="n19" value="build só corre com todos os jobs verdes (needs) · cobertura real, skip não mascara falha em CI" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;" vertex="1" parent="n10"><mxGeometry x="20" y="300" width="515" height="26" as="geometry"/></mxCell><mxCell id="n20" value="3 · Imagem OCI — Dockerfile multi-stage" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9ff;strokeColor=#c9cfdd;fontColor=#0b1c30;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;container=1;pointerEvents=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="300" height="420" as="geometry"/></mxCell><mxCell id="n21" value='&lt;b&gt;deps&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;node:alpine · pnpm install --frozen-lockfile&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillC