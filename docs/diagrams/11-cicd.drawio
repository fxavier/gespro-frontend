="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="n32" value='&lt;b&gt;instância 1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;nova imagem · sai da rotação do proxy · /api/ready&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n29"><mxGeometry x="500" y="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="n33" value='&lt;b&gt;smoke autenticado&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;login · POS · factura · exports&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n29"><mxGeometry x="740" y="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="n34" value='&lt;b&gt;instância 2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;contract: limpeza só na versão seguinte&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n29"><mxGeometry x="980" y="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0b1c30;fontColor=#0b1c30;fontSize=10;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0b1c30;fontColor=#0b1c30;fontSize=10;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0b1c30;fontColor=#0b1c30;fontSize=10;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="n32" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0b1c30;fontColor=#0b1c30;fontSize=10;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="n33" target="n34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="nenhuma publicação à mão sem registo · configuração só por variáveis de ambiente, nunca código por ambiente" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;" vertex="1" parent="n29"><mxGeometry x="20" y="120" width="1200" height="30" as="geometry"/></mxCell><mxCell id="n40" value="5 · Destino" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;container=1;pointerEvents=0;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1360" y="100" width="300" height="630" as="geometry"/></mxCell><mxCell id="n41" value='&lt;b&gt;Ambiente local de referência&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;hoje: docker compose --profile full · 2 instâncias + proxy · ensaio de restauro&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n40"><mxGeometry x="20" y="35" width="260" height="80" as="geometry"/></mxCell><mxCell id="n42" value='&lt;b&gt;dev → prod (por provisionar)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;dev primeiro, destruído e recriado uma vez; prod só depois da identidade validada (ADR-0022 §1)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f3f7;strokeColor=#8b93a7;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;dashed=1;" vertex="1" parent="n40"><mxGeometry x="20" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="n43" value='&lt;b&gt;Candidato AWS (infra/)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;Terraform: bootstrap · modules network/rds/app/secrets/storage · live dev/prod · App Runner + RDS + Secrets Manager&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f3f7;strokeColor=#8b93a7;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;dashed=1;" vertex="1" parent="n40"><mxGeometry x="20" y="255" width="260" height="100" as="geometry"/></mxCell><mxCell id="n44" value='&lt;b style="color:#0b1c30"&gt;Por decidir&lt;/b&gt; (ADR-0026 §5): fornecedor. Requisitos: Postgres gerido com PITR, contentores, Redis-compatível, S3-compatível, OTLP, SMTP. RPO 5 min · RTO 4 h.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;" vertex="1" parent="n40"><mxGeometry x="20" y="370" width="260" height="120" as="geometry"/></mxCell><mxCell id="n45" value="push / PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0b1c30;fontColor=#0b1c30;fontSize=10;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;exitY=0.15;entryX=0;entryY=0.15;" edge="1" parent="1" source="n4" target="n10"><mxGeometry y="-12" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0b1c30;fontColor=#0b1c30;fontSize=10;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;fontFamily=Helvetica;exitX=1;ex