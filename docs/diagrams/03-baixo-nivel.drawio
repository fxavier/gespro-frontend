r=#dff3f5;strokeColor=#00788c;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;verticalAlign=top;spacingTop=4;" vertex="1" parent="n17"><mxGeometry x="20" y="35" width="205" height="130" as="geometry"/></mxCell><mxCell id="n19" value='&lt;b&gt;B · Compras &amp;amp; Serviços&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#0b1c30"&gt;4 serviços · 27 modelos&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#8b93a7"&gt;requisições, aprovação multi-nível, cotações, pedidos, recepção, fornecedores, contas a pagar, serviços/agendamentos&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf0dc;strokeColor=#b5651d;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;verticalAlign=top;spacingTop=4;" vertex="1" parent="n17"><mxGeometry x="242" y="35" width="205" height="130" as="geometry"/></mxCell><mxCell id="n20" value='&lt;b&gt;C · Comercial &amp;amp; POS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#0b1c30"&gt;7 serviços · 18 modelos&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#8b93a7"&gt;clientes, vendas, sessão POS, encomendas, devoluções, trocas, vendedores, comissões&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ebfb;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;verticalAlign=top;spacingTop=4;" vertex="1" parent="n17"><mxGeometry x="464" y="35" width="205" height="130" as="geometry"/></mxCell><mxCell id="n21" value='&lt;b&gt;D · Finanças&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#0b1c30"&gt;3 serviços · 21 modelos&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#8b93a7"&gt;caixa (sessões), facturação (séries, NC/ND), contabilidade PGC-NIRF (partida dobrada, diários, reconciliação)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f3e6;strokeColor=#2e7d4f;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;verticalAlign=top;spacingTop=4;" vertex="1" parent="n17"><mxGeometry x="686" y="35" width="205" height="130" as="geometry"/></mxCel