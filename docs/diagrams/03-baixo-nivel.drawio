<mxfile host="drawio" version="26.0.0"><diagram name="Baixo-Nivel" id="p1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value='&lt;span style="font-size:22px"&gt;&lt;b&gt;03 · Arquitectura de baixo nível (C4 nível 3 — componentes do ERP)&lt;/b&gt;&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0b1c30;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1500" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Camadas do monólito modular, pipelines de entrada, 7 domínios com contratos publicados e camadas transversais. GestPro ERP · Setembro 2026 · fonte: código em apps/, docs/decisions (ADR-0001…0031)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1500" height="22" as="geometry"/></mxCell><mxCell id="n4" value="UI — App Router (src/app) · Português de Portugal · dark mode obrigatório · sem modais" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9ff;strokeColor=#c9cfdd;fontColor=#0b1c30;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;container=1;pointerEvents=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1580" height="120" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;Server Components (page.tsx)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;listagem/detalhe: chamam o serviço dentro de runWithTenantContext; nunca fetch à própria API&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="20" y="35" width="280" height="70" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Client Components&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;formulários react-hook-form + zodResolver (schema partilhado em lib/validations)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="320" y="35" width="280" height="70" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Patterns (components/patterns)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;PageHeader · DataTable · FilterBar · StatusBadge · DetailShell · FormPage · Combobox(Remoto)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="620" y="35" width="280" height="70" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;middleware.ts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;único dono dos headers de segurança e PUBLIC_PATHS; redirige para /auth/login&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="920" y="35" width="280" height="70" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Layout (dashboard)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;AppSidebar (rail recolhível, cookie) · AppHeader (⌘K) · tokens @theme de packages/brand&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="n4"><mxGeometry x="1220" y="35" width="340" height="70" as="geometry"/></mxCell><mxCell id="n10" value="Pipelines de entrada — sessão → permissão → Zod → contexto de tenant → handler" style="rounded=1;arcSize=6;whiteSp