          <mxGeometry x="330" y="20" width="740" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Convenção DFD: ellipse=entidade externa · rounded=processo · cylinder=data store. Tudo dentro de uma única $transaction (atómico)." style="text;html=1;align=center;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="52" width="740" height="20" as="geometry" />
