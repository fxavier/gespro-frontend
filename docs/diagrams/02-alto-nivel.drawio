<mxfile host="drawio" version="26.0.0"><diagram name="Alto-Nivel" id="p1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value='&lt;span style="font-size:22px"&gt;&lt;b&gt;02 · Arquitectura de alto nível (C4 nível 2 — contentores)&lt;/b&gt;&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0b1c30;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Contentores em execução, protocolos e portas do ambiente local de referência (ADR-0026). GestPro ERP · Setembro 2026 · fonte: código em apps/, docs/decisions (ADR-0001…0031)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1400" height="22" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;Browser — utilizador autenticado&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;React 19 · Client Components · cookie de sessão JWT (tecto 12 h)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;Browser — visitante&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;site público&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="260" height="60" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Proxy / balanceador&lt;/b&