Space=wrap;fontSize=10;fontColor=#8b93a7;fontFamily=Helvetica;" vertex="1" parent="n7"><mxGeometry x="320" y="30" width="290" height="180" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Site de marketing — Next.js 16&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;SSG/ISR · next-intl · lê o catálogo de planos do ERP&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2257d8;fontColor=#0b1c30;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;BD «gespro» (Prisma, 169 modelos) + BD «keycloak» · WAL arquivado&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#0b1c30;fontColor=#0b1c30;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="250" height="90" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Keycloak 26.7&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;realm gespro · cliente gespro-erp · directAccessGrants · brute force&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b1c30;strokeColor=#0b1c30;fontColor=#ffffff;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="520" width="240" height="90" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Valkey 8&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7"&gt;limitador de tráfego partilhado (janela deslizante) · cache futura&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b1c30;strokeColor=#0b1c30;fontColor=#ffffff;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="520" width="220" height="90" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b&gt;MinIO / S3&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#8b93a7