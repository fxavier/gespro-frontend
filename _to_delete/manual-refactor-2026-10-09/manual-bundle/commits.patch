+                  <th className="py-2 font-medium">Operação</th>
+                  <th className="py-2 font-medium">Centro de trabalho</th>
+                  <th className="py-2 font-medium text-right">Tempo (min)</th>
+                  <th className="py-2 font-medium text-right">Custo/hora</th>
