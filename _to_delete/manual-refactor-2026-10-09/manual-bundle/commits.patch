+                emptyText="Sem localizações activas."
+              />
+              {erros.localizacao && <p className="text-sm text-destructive">{erros.localizacao}</p>}
+            </div>
+            <div className="space-y-2">
+              <Label htmlFor="data">Data da recepção *</Label>
